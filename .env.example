# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional External Job Board API Credentials (configured by Administrator)
# Adzuna Job Search API (https://developer.adzuna.com/)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Optional Email Notification Delivery Provider
# Resend API Key (https://resend.com/)
RESEND_API_KEY=""
# Or SMTP Configuration
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="alerts@meridianjobs.app"

# Comma-separated list of administrator email addresses
ADMIN_EMAILS=""
