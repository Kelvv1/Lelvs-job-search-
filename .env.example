# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional External Job Board API Credentials (configured when ready)
# Obtain ADZUNA_APP_ID and ADZUNA_APP_KEY from https://developer.adzuna.com/
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Optional Email Notification Delivery Provider (Resend)
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY=""

# Resend SMTP Relay Configuration (SMTP_PASS uses your Resend API key once obtained)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS=""
SMTP_FROM="onboarding@resend.dev"

# Comma-separated list of administrator email addresses (also editable in Admin Integrations Settings)
ADMIN_EMAILS=""
